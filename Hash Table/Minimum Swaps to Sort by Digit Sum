class Solution {
public:
    int minSwaps(vector<int>& nums) {
        int n = nums.size();
        vector<pair<int, int>> ans;
        unordered_map<int, int> pos;
        for (int i = 0; i < n; i++) {
            int x = nums[i];
            int sum = 0;
            while (x > 0) {
                sum += x % 10;
                x /= 10;
            }
            ans.push_back({sum, nums[i]});
            pos[nums[i]] = i;
        }
        sort(ans.begin(), ans.end());
        int count = 0;
        for (int i = 0; i < n; i++) {
            int target = ans[i].second;
            if (nums[i] == target)
                continue;
            int j = pos[target];
            pos[nums[i]] = j;
            pos[nums[j]] = i;
            swap(nums[i], nums[j]);
            count++;
        }
        return count;
    }
};
