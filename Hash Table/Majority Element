class Solution {
public:
    int majorityElement(vector<int>& nums) {
        int maxi = 0;
        int element = 0;
       unordered_map<int, int>ans;
       for(int i=0;i<nums.size();i++){
            ans[nums[i]]++;
       } 
       for(auto it:ans){
            // maxi=max(maxi,it.first);
            if(it.second>maxi){
                maxi=it.second;
                element=it.first;
            }
       }
       return element;
    }
};
