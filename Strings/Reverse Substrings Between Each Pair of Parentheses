class Solution {
public:
    string reverseParentheses(string s) {
        int n = s.size();
        vector<int> match(n);
        stack<int> st;

        for (int i = 0; i < n; ++i) {
            if (s[i] == '(') {
                st.push(i);
            } else if (s[i] == ')') {
                int open = st.top();
                st.pop();
                match[open] = i;
                match[i] = open;
            }
        }

        string result;
        int direction = 1;

        for (int i = 0; i < n; i += direction) {
            if (s[i] == '(' || s[i] == ')') {
                i = match[i];
                direction = -direction;
            } else {
                result += s[i];
            }
        }

        return result;
    }
};
