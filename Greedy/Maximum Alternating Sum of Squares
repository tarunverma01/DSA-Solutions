class Solution {
public:
    long long maxAlternatingSum(vector<int>& nums) {
       vector<long long> tt;
       for(int i=0;i<nums.size();i++){
        tt.push_back(1LL*nums[i]*nums[i]);
       } 
       sort(tt.begin(),tt.end(),greater<long long>());
       long long ans=0;
       int n=tt.size();
       for(int i=0;i<n;i++){
            if(i<(n+1)/2) ans+=tt[i];
            else ans-=tt[i];
       }
       return ans;
    }
};
