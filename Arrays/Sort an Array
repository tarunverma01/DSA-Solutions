
class Solution {
public:
    vector<int> sortArray(vector<int>& nums) {

        int n = nums.size();

        vector<int> count(100001, 0);

        for(int i = 0; i < n; i++) {
            count[nums[i] + 50000]++;
        }

        vector<int> ans;

        for(int i = 0; i < 100001; i++) {

            while(count[i] > 0) {
                ans.push_back(i - 50000);
                count[i]--;
            }
        }

        return ans;
    }
};
