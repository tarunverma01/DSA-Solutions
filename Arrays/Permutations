class Solution {
public:
    vector<vector<int>>ans;
    void solve(vector<int>& nums, int k){
        if(k==nums.size()){
            ans.push_back(nums);
            return;
        }
        for(int i=k;i<nums.size();i++){
            swap(nums[k],nums[i]);
            solve(nums,k+1);
            swap(nums[k],nums[i]);
        }
    }
    vector<vector<int>> permute(vector<int>& nums) {
        solve(nums,0);
        return ans;
    }
};
